<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="1000.0" maxWidth="600.0" minWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javafx.vistaNuevaFlota.controladorNuevaFlota">
   <children>
      <HBox alignment="CENTER" maxHeight="100.0" minHeight="100.0" prefHeight="100.0" spacing="60.0">
         <children>
            <RadioButton fx:id="radioImperio" contentDisplay="CENTER" mnemonicParsing="false" prefHeight="60.0" prefWidth="120.0" selected="true" styleClass="custom-radio" text="Imperio">
               <toggleGroup>
                  <ToggleGroup fx:id="flotaSeleccionada" />
               </toggleGroup>
            </RadioButton>
            <RadioButton fx:id="radioRebeldes" contentDisplay="CENTER" mnemonicParsing="false" prefHeight="60.0" prefWidth="120.0" styleClass="custom-radio" text="Rebeldes" toggleGroup="$flotaSeleccionada" />
            <RadioButton fx:id="radioPiratas" contentDisplay="CENTER" mnemonicParsing="false" prefHeight="60.0" prefWidth="120.0" styleClass="custom-radio" text="Piratas" toggleGroup="$flotaSeleccionada" />
         </children>
         <VBox.margin>
            <Insets top="50.0" />
         </VBox.margin>
      </HBox>
      <HBox alignment="CENTER" maxHeight="100.0" minHeight="100.0" prefHeight="100.0" spacing="60.0">
         <children>
            <RadioButton fx:id="radioRepublica" contentDisplay="CENTER" mnemonicParsing="false" prefHeight="60.0" prefWidth="120.0" styleClass="custom-radio" text="República" toggleGroup="$flotaSeleccionada" />
            <RadioButton fx:id="radioSeparatistas" contentDisplay="CENTER" mnemonicParsing="false" prefHeight="60.0" prefWidth="120.0" styleClass="custom-radio" text="Separatistas" toggleGroup="$flotaSeleccionada" />
            <RadioButton fx:id="radioMercenarios" contentDisplay="CENTER" mnemonicParsing="false" prefHeight="60.0" prefWidth="120.0" styleClass="custom-radio" text="Mercenarios" toggleGroup="$flotaSeleccionada" />
         </children>
      </HBox>
      <HBox alignment="CENTER_LEFT" maxHeight="50.0" minHeight="50.0" prefHeight="50.0">
         <children>
            <Label fx:id="labelNombreFlota" minWidth="100.0" text="Nombre:">
               <HBox.margin>
                  <Insets left="50.0" />
               </HBox.margin>
               <tooltip>
                  <Tooltip text="Nombre único de la flota" />
               </tooltip>
            </Label>
            <TextField fx:id="nombreFlota" minWidth="400.0">
               <tooltip>
                  <Tooltip text="Nombre único de la flota" />
               </tooltip></TextField>
         </children>
         <VBox.margin>
            <Insets />
         </VBox.margin>
      </HBox>
      <AnchorPane>
         <children>
            <ScrollPane hbarPolicy="NEVER" minWidth="600.0">
               <content>
                  <VBox fx:id="contenedorNaves" minWidth="600.0" prefHeight="250.0">
                     <children>
                        <HBox fx:id="fila" alignment="CENTER_LEFT" maxHeight="50.0" minHeight="50.0" minWidth="600.0" prefHeight="50.0">
                           <children>
                              <Label minWidth="100.0" text="Naves:">
                                 <HBox.margin>
                                    <Insets left="50.0" />
                                 </HBox.margin>
                              </Label>
                              <ComboBox fx:id="naveEscogida" minWidth="150.0" />
                              <Label minWidth="80.0" text="Cantidad:">
                                 <HBox.margin>
                                    <Insets left="20.0" />
                                 </HBox.margin>
                              </Label>
                              <TextField fx:id="cantidadnaves" minWidth="150.0" text="1" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </content>
               <tooltip>
                  <Tooltip text="Mínimo 1 nave con cantidad superior a 1, de otro modo no se puede crear la flota" />
               </tooltip>
            </ScrollPane>
         </children>
      </AnchorPane>
      <HBox alignment="CENTER" prefHeight="100.0" prefWidth="600.0">
         <children>
            <Button cancelButton="true" minHeight="30.0" minWidth="150.0" mnemonicParsing="false" onAction="#botonCancelar" text="Cancelar">
               <HBox.margin>
                  <Insets left="20.0" right="20.0" />
               </HBox.margin>
            </Button>
            <Button defaultButton="true" minHeight="30.0" minWidth="150.0" mnemonicParsing="false" onAction="#botonNuevaFlota" text="Aceptar">
               <HBox.margin>
                  <Insets />
               </HBox.margin></Button>
         </children>
      </HBox>
   </children>
</VBox>
